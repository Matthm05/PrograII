@startuml 

class Vehiculo{
    -int numAsientos
    -String color
    -String modelo
    -int año
    -int hp
    -int numPuertas
    +encender()
    +frenar()
    +acelerar()
    +apagar()

}

class Camioneta{
    -doube capacidadBalde
}
class SUV{
    -String traccion;
}
class Sedan{
    -boolean convertible;
}


'Asociaciones
Vehiculo <|-- Camioneta
Vehiculo <|-- SUV
Vehiculo <|-- Sedan

@enduml