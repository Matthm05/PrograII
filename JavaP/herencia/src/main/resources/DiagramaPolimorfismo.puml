@startuml 

interface Cargable{
    cargar(double: peso)
    descargar(double: peso)
}

abstract class Vehiculo{
    -int plazas
    -String color
    -String modelo
    -int año
    -int llantas
    +encender()
    +frenar()
    +acelerar()
    +apagar()
}

class Camioneta{
    -doube capacidadValde
    

}
class Motocicleta{
    -String tipoManubrio
    +levantarAsiento()
}
class Automovil{
    -boolean convertible
    +abrirTechoPanoramico()
}
class Camion{
    -int capCarga
    +levantarCabina()
}



'Asociaciones
Vehiculo <|-- Camioneta
Vehiculo <|-- Motocicleta
Vehiculo <|-- Automovil
Vehiculo <|-- Camion
Cargable <|.. Camion
Cargable <|.. Camioneta
@enduml